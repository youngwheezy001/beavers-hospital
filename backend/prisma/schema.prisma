// This is your Database Blueprint
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 1. USERS (Patients, Doctors, Admins)
model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  full_name String
  phone     String?
  role      Role     @default(PATIENT)
  createdAt DateTime @default(now())

  patientProfile PatientProfile?
  staffProfile   StaffProfile?
}

enum Role {
  PATIENT
  DOCTOR
  ADMIN
}

// 2. PROFILES
model PatientProfile {
  id           String        @id @default(uuid())
  user_id      String        @unique
  user         User          @relation(fields: [user_id], references: [id])
  appointments Appointment[]
}

model StaffProfile {
  id           String        @id @default(uuid())
  user_id      String        @unique
  user         User          @relation(fields: [user_id], references: [id])
  position     String        // e.g. "Doctor", "Nurse"
  is_online    Boolean       @default(false)
  appointments Appointment[]
}

// 3. CLINIC DATA
model Branch {
  id           String          @id @default(uuid())
  name         String          @unique // "Ngong", "El Paso", "Nairobi"
  services     BranchService[]
  appointments Appointment[]
}

model Service {
  id           String          @id @default(uuid())
  name         String          @unique // "Dental", "Optical"
  branches     BranchService[]
  appointments Appointment[]   // <--- FIXED: Lowercase 'appointments'
}

// Link Table: Which Branch has which Service?
model BranchService {
  id           String        @id @default(uuid())
  branch_id    String
  service_id   String
  branch       Branch        @relation(fields: [branch_id], references: [id])
  service      Service       @relation(fields: [service_id], references: [id])
  appointments Appointment[]
}

// 4. THE BOOKING
model Appointment {
  id                String         @id @default(uuid())
  start_time        DateTime
  status            String         @default("PENDING")
  // ADD THESE TWO LINES:
  doctor_name  String?  // Optional: The assigned doctor's name
  doctor_email String?  // Optional: Where to send the alert

  patient_id        String
  patient           PatientProfile @relation(fields: [patient_id], references: [id])

  doctor_id         String?
  doctor            StaffProfile?  @relation(fields: [doctor_id], references: [id])

  branch_id         String
  branch            Branch         @relation(fields: [branch_id], references: [id])

  service_booked_id String?
  service_booked    BranchService? @relation(fields: [service_booked_id], references: [id])
  
  // Direct link for simpler queries
  service_id        String?
  service           Service?       @relation(fields: [service_id], references: [id]) 
  
  createdAt         DateTime       @default(now())
}